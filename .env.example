# .env.example
# Phase 5B — Free-Tier Gemini configuration
#
# IMPORTANT:
# This is an example only.
# Never put a real API key in this file.

GEMINI_API_KEY=your_gemini_api_key_here

# Must be a model currently available to your Gemini Free Tier.
# Verify before real-model integration.
GEMINI_MODEL=gemini-3.1-flash-lite

# Existing Phase 5 guardrail configuration.
AGENT_CALL_TIMEOUT_SECONDS=10

# Maximum generated output tokens for the bounded provider call.
AGENT_MAX_OUTPUT_TOKENS=512

# NON-NEGOTIABLE PROJECT CONSTRAINT:
# No paid API fallback or paid model escalation.
AGENT_FREE_ONLY=true